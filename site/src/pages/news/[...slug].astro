---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import JournalText from "../../components/JournalText.astro";
export async function getStaticPaths() {
  return (await getCollection("news")).map((news) => ({
    params: { slug: news.id },
    props: { news },
  }));
}
const { news } = Astro.props as { news: CollectionEntry<"news"> };
const { Content } = await render(news);
const title = news.data.title;
---

<Layout title={title}>
  <article class="page-stack research-detail">
    <header class="page-header">
      <a href="/news/" class="action-link">
        <span class="i-ph-arrow-left" aria-hidden="true" />
        news
      </a>
      <h1 class="page-title">
        <JournalText text={title} />
      </h1>
      <p class="entry-meta">
        <time datetime={news.data.date.toISOString()}>
          {news.data.date.toLocaleDateString("en-US", {
            month: "long",
            day: "2-digit",
            year: "numeric",
            timeZone: "Asia/Shanghai",
          })}
        </time>
      </p>
    </header>
    <div class="prose-copy">
      <Content />
    </div>
  </article>
</Layout>
