---
import Layout from "../layouts/Layout.astro";
import PublicationList from "../components/PublicationList.astro";
import NewsList from "../components/NewsList.astro";
import { getEntry, render } from "astro:content";
import { getFeaturedPapers } from "../lib/papers";
import siteConfig from "../side.config";
const profile = await getEntry("profile", "about");
if (!profile) throw new Error("Missing original biography");
const { Content } = await render(profile);
---

<Layout schemaType="ProfilePage">
  <div class="page-stack home-page">
    <section class="profile-section" aria-labelledby="profile-name">
      <div class="profile-intro">
        <h1 id="profile-name" class="profile-name">
          Jianshu Wang
        </h1>
        <p class="profile-subtitle">{siteConfig.hero.headline}</p>
        <div class="profile-biography prose-copy">
          <Content />
        </div>
        <nav class="profile-links" aria-label="Academic profiles">
          {siteConfig.socialLinks.map((link) => (
            <a class="action-link" href={link.href}>
              <span class={`${link.icon} text-base`} aria-hidden="true" />
              {link.label}
            </a>
          ))}
        </nav>
      </div>
      <aside class="profile-aside" aria-label="Profile">
        <img
          src="/assets/img/profile.jpg"
          alt="Jianshu Wang"
          width="270"
          height="430"
          fetchpriority="high"
          class="profile-portrait"
        />
        <p>Research Assistant, Lifedu Educational Technology Co., Ltd.</p>
        <p>B.S. in Applied Psychology, Henan University (2026)</p>
        <a href="mailto:jishuu825@gmail.com">jishuu825@gmail.com</a>
      </aside>
    </section>
    <section aria-labelledby="news-heading">
      <h2 id="news-heading" class="section-heading section-label">
        <a href="/news/">news</a>
      </h2>
      <NewsList limit={3} />
    </section>
    <section aria-labelledby="selected-publications">
      <h2 id="selected-publications" class="section-heading section-label">
        <a href="/publications/">selected publications</a>
      </h2>
      <PublicationList papers={getFeaturedPapers(6)} />
    </section>
    <p class="contact-note">
      For research collaboration or academic inquiries, feel free to contact me
      by <a href="mailto:jishuu825@gmail.com">email</a>.
    </p>
  </div>
</Layout>
