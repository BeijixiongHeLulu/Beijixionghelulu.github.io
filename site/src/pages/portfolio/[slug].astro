---
import Layout from "../../layouts/Layout.astro";
import PortfolioCaseShell from "../../components/PortfolioCaseShell.astro";
import { portfolio } from "../../portfolio/registry";
import type { PortfolioCase } from "../../portfolio/types";
import "../../styles/portfolio.css";

export function getStaticPaths() {
  return portfolio.map((entry) => ({
    params: { slug: entry.metadata.slug },
    props: entry,
  }));
}
const { Component } = Astro.props;
const item: PortfolioCase = Astro.props.metadata;
---

<Layout title={item.title} description={item.description}>
  <PortfolioCaseShell item={item}>
    <div slot="intro">
      <Component part="intro" />
    </div>
    <div slot="visual">
      <Component part="visual" />
    </div>
    <Component part="body" />
    <div class="portfolio-resources">
      {item.resources.map((resource) => {
        const external = /^https?:/.test(resource.href);
        return (
          <a
            class={
              resource.kind === "publication" ? "btn-primary" : "action-link"
            }
            href={resource.href}
            target={external ? "_blank" : undefined}
            rel={external ? "noopener noreferrer" : undefined}
          >
            {resource.label}
            <span aria-hidden="true">{external ? "↗" : "→"}</span>
            {external && <span class="sr-only">opens in a new tab</span>}
          </a>
        );
      })}
    </div>
  </PortfolioCaseShell>
</Layout>
