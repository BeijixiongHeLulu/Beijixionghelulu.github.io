---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import siteConfig from "../side.config";
const projects = (
  await getCollection("projects", ({ data }) => !data.draft)
).sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="research"
  description={siteConfig.pageTitles.projects.description}
  schemaType="CollectionPage"
>
  <div class="page-stack">
    <header class="page-header">
      <h1 class="page-title">research</h1>
      <p class="page-description">
        {siteConfig.pageTitles.projects.description}
      </p>
    </header>
    <div class="research-grid">
      {projects.map((project) => (
        <a class="surface-card research-card" href={`/projects/${project.id}/`}>
          <h2 class="entry-title">{project.data.title}</h2>
          <p class="entry-summary">{project.data.summary}</p>
          <span class="research-arrow i-ph-arrow-up-right" aria-hidden="true" />
        </a>
      ))}
    </div>
  </div>
</Layout>
