---
import { Image } from "astro:assets";
import ResearchFigure from "../../components/ResearchFigure.astro";
import type { CasePart } from "../types";
import setup from "./cockpit-platform-original.jpeg";
import display from "./cockpit-display-original.jpeg";
import sensors from "./cockpit-sensors-original.jpeg";
import keypress from "./cockpit-keypress-illustration.png";
import motionClip from "./cockpit-platform-demo.mp4?url";
import motionPoster from "./cockpit-platform-demo-poster.jpg";
interface Props {
  part: CasePart;
}
const { part } = Astro.props;
---

{part === "intro" && (
  <p>
    I developed the Unity/C# directional-judgment task on an existing
    six-degree-of-freedom motion platform and analyzed response times in
    relation to independently measured motion.
  </p>
)}
{part === "visual" && (
  <div class="cockpit-setup">
    <figure class="portfolio-figure cockpit-video">
      <video
        controls
        muted
        playsinline
        preload="auto"
        poster={motionPoster.src}
        width="960"
        height="544"
        aria-label="Five-second demonstration of the motion platform and directional task"
        aria-describedby="cockpit-video-caption"
      >
        <source src={motionClip} type="video/mp4" />
        <a href={motionClip}>Watch the five-second platform demonstration.</a>
      </video>
      <figcaption id="cockpit-video-caption">
        Five-second demonstration of the motion platform and directional task,
        with the seat unoccupied.
      </figcaption>
    </figure>
  </div>
)}
{part === "body" && (
  <>
    <section class="portfolio-section" aria-labelledby="cockpit-task-heading">
      <h2 id="cockpit-task-heading">Responding in a moving environment</h2>
      <p class="portfolio-copy">
        In a moving vehicle, people still need to interpret visual cues and act
        on them. We used a simple directional task to study response speed and
        accuracy under different motion conditions.
      </p>
      <div class="cockpit-task-layout">
        <div class="cockpit-detail cockpit-study-images">
          <ResearchFigure
            src={setup}
            alt="Participant on the existing motion platform facing three displays. The original face covering and complete platform base are visible."
          >
            Study setup with a seated participant.
          </ResearchFigure>
          <ResearchFigure
            src={display}
            alt="The actual task display shows an upward green arrow; a four-direction keypad sits beside it."
          >
            Task display and directional keys.
          </ResearchFigure>
        </div>
        <figure class="portfolio-figure cockpit-task-story">
          <ol class="cockpit-screens" aria-label="Illustrated trial sequence">
            <li>
              <span class="cockpit-screen-label">1 · Fixation</span>
              <div class="cockpit-screen" aria-hidden="true">
                <span class="cockpit-fixation">+</span>
              </div>
            </li>
            <li class="cockpit-cue-stage">
              <span class="cockpit-screen-label">2 · Directional cue</span>
              <div class="cockpit-screen" aria-hidden="true">
                <svg viewBox="0 0 100 100">
                  <path d="M50 16L22 48H40V84H60V48H78Z" fill="#7fda71" />
                </svg>
              </div>
              <Image
                src={keypress}
                alt="Illustration of an index finger pressing the upward key of a four-direction keypad."
                format="webp"
                widths={[240, 480]}
                sizes="240px"
                width={keypress.width}
                height={keypress.height}
                class="cockpit-keypress"
              />
              <span class="cockpit-response-label">
                Response during the cue
              </span>
            </li>
            <li>
              <span class="cockpit-screen-label">3 · Blank interval</span>
              <div class="cockpit-screen" aria-hidden="true"></div>
            </li>
          </ol>
          <figcaption>
            Illustrated directional task: participants matched a visual arrow to
            a directional key.
          </figcaption>
        </figure>
      </div>
    </section>
    <section class="portfolio-section" aria-labelledby="cockpit-motion-heading">
      <h2 id="cockpit-motion-heading">Motion relative to the task</h2>
      <p class="portfolio-copy">
        I considered both motion intensity and the direction of movement
        relative to the current cue. The same acceleration can lie along one
        target direction and across another.
      </p>
      <div class="cockpit-measurement-layout">
        <div class="cockpit-detail">
          <ResearchFigure
            src={sensors}
            alt="Two motion sensors mounted beneath the participant's seat."
          >
            Sensors beneath the seat recorded physical motion.
          </ResearchFigure>
        </div>
        <figure class="portfolio-figure cockpit-geometry">
          <div class="cockpit-geometry-drawing">
            <svg
              viewBox="0 0 440 290"
              role="img"
              aria-labelledby="cockpit-geometry-title cockpit-geometry-description"
            >
              <title id="cockpit-geometry-title">A cue-relative reference frame</title>
              <desc id="cockpit-geometry-description">
                An upward cue defines the along-cue direction. The across-cue
                direction is perpendicular. An illustrative diagonal motion
                vector has components in both directions.
              </desc>
              <path
                d="M115 232V52M115 232H349"
                fill="none"
                stroke="#73858e"
                stroke-width="2"
              />
              <path
                d="M109 61L115 48L121 61M340 226L353 232L340 238"
                fill="none"
                stroke="#73858e"
                stroke-width="2"
              />
              <path
                d="M115 90H269V232"
                fill="none"
                stroke="#b3c4ca"
                stroke-width="2"
                stroke-dasharray="5 6"
              />
              <path
                d="M115 232L265 94"
                fill="none"
                stroke="#346579"
                stroke-width="5"
              />
              <path
                d="M247 97L270 88L260 112"
                fill="none"
                stroke="#346579"
                stroke-width="5"
              />
              <circle cx="115" cy="232" r="5" fill="#346579" />
            </svg>
            <ul
              class="cockpit-direction-key"
              aria-label="Directions in the illustration"
            >
              <li>
                <span aria-hidden="true">↑</span> Along cue
              </li>
              <li>
                <span aria-hidden="true">→</span> Across cue
              </li>
              <li class="cockpit-motion-key">
                <span aria-hidden="true">↗</span> Motion
              </li>
            </ul>
          </div>
          <figcaption>Example task-relative reference frame.</figcaption>
        </figure>
      </div>
    </section>
    <details class="portfolio-methods">
      <summary>Why target direction matters</summary>
      <p>
        Target direction defines both the motion reference frame and the
        response required by the task. I accounted for differences between
        target directions when interpreting the relationship between measured
        motion and response time.
      </p>
    </details>
  </>
)}
<style>
  .cockpit-setup {
    max-width: 850px;
    margin-inline: auto;
  }
  .cockpit-video video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 5px;
    background: #191b20;
  }
  .cockpit-study-images {
    display: grid;
    gap: 1.5rem;
  }
  .cockpit-task-layout,
  .cockpit-measurement-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.65fr);
    gap: 2.25rem;
    align-items: start;
  }
  .cockpit-task-layout {
    margin-top: 1.5rem;
  }
  .cockpit-detail {
    max-width: 340px;
  }
  .cockpit-screens {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .cockpit-screens li {
    min-width: 0;
    position: relative;
  }
  .cockpit-screen-label {
    display: block;
    font-size: 0.85rem;
    line-height: 1.5;
    font-weight: 600;
    min-height: 2.8em;
    margin-bottom: 0.4rem;
    color: var(--portfolio-ink);
  }
  .cockpit-screen {
    aspect-ratio: 4/3;
    background: #191b20;
    border: 5px solid #45515a;
    border-bottom-width: 9px;
    border-radius: 5px;
    display: grid;
    place-items: center;
    position: relative;
  }
  .cockpit-screen::after {
    content: "";
    width: 35%;
    height: 5px;
    position: absolute;
    top: calc(100% + 9px);
    background: #45515a;
  }
  .cockpit-fixation {
    color: #e8ebe9;
    font:
      400 3rem/1 Arial,
      sans-serif;
  }
  .cockpit-screen svg {
    width: 52%;
    height: 75%;
  }
  .cockpit-keypress {
    display: block;
    width: 100%;
    max-width: 240px;
    height: auto;
    background: #f5f6f5;
    border-radius: 5px;
    margin: 0.5rem auto 0;
  }
  .cockpit-response-label {
    display: block;
    font-size: 0.8rem;
    line-height: 1.5;
    text-align: center;
    margin-top: 0.4rem;
    color: var(--portfolio-muted);
  }
  .cockpit-task-story figcaption {
    margin-top: 1.25rem;
  }
  .cockpit-measurement-layout {
    align-items: center;
    margin-top: 1.5rem;
  }
  .cockpit-geometry {
    max-width: 580px;
  }
  .cockpit-geometry-drawing {
    background: #f6f8f7;
    border-radius: 5px;
  }
  .cockpit-geometry-drawing svg {
    width: 100%;
    max-width: 440px;
    height: auto;
    margin: 0 auto;
    display: block;
  }
  .cockpit-direction-key {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 1rem;
    list-style: none;
    padding: 0 12px 12px;
    margin: 0;
    color: #355a69;
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .cockpit-direction-key li {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }
  .cockpit-direction-key li span {
    color: #73858e;
    font-size: 1.25em;
    font-weight: 700;
  }
  .cockpit-direction-key .cockpit-motion-key span {
    color: #346579;
  }
  @media (max-width: 767px) {
    .cockpit-task-layout,
    .cockpit-measurement-layout {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
    .cockpit-detail {
      width: min(100%, 300px);
      margin-inline: auto;
    }
    .cockpit-geometry {
      width: 100%;
      max-width: 580px;
      margin-inline: auto;
    }
  }
  @media (max-width: 539px) {
    .cockpit-direction-key {
      flex-direction: column;
      align-items: center;
    }
    .cockpit-screens {
      grid-template-columns: 1fr;
      gap: 1.6rem;
    }
    .cockpit-screens li {
      width: 100%;
      max-width: 320px;
      margin-inline: auto;
    }
    .cockpit-screen {
      max-width: 240px;
      margin-inline: auto;
    }
    .cockpit-screen-label {
      min-height: 0;
      text-align: center;
      margin-bottom: 0.7rem;
    }
    .cockpit-keypress {
      width: min(100%, 200px);
    }
  }
</style>
