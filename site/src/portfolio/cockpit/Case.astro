---
import { Image } from "astro:assets";
import ResearchFigure from "../../components/ResearchFigure.astro";
import type { CasePart } from "../types";
import setup from "./cockpit-platform-original.jpeg";
import display from "./cockpit-display-original.jpeg";
import sensors from "./cockpit-sensors-original.jpeg";
import keypress from "./cockpit-keypress-illustration.png";
interface Props {
  part: CasePart;
}
const { part } = Astro.props;
---

{part === "intro" && (
  <p>
    I developed a Unity directional-judgment task for an existing
    six-degree-of-freedom motion platform and analyzed response times in
    relation to task-relative measured motion.
  </p>
)}
{part === "visual" && (
  <div class="cockpit-setup">
    <ResearchFigure
      src={setup}
      alt="Participant on the existing motion platform facing three displays. The original face covering and complete platform base are visible."
      eager
    >
      The existing platform delivered whole-body motion during an on-screen
      task.
    </ResearchFigure>
  </div>
)}
{part === "body" && (
  <>
    <section class="portfolio-section" aria-labelledby="cockpit-task-heading">
      <h2 id="cockpit-task-heading">Responding during motion</h2>
      <div class="cockpit-task-layout">
        <div class="cockpit-detail">
          <ResearchFigure
            src={display}
            alt="The actual task display shows an upward green arrow; a four-direction keypad sits beside it."
          >
            Task display and directional keys.
          </ResearchFigure>
        </div>
        <figure class="portfolio-figure cockpit-task-story">
          <ol class="cockpit-screens" aria-label="Illustrated trial sequence">
            <li>
              <span class="cockpit-screen-label">1 · Fixation</span>
              <div class="cockpit-screen" aria-hidden="true">
                <span class="cockpit-fixation">+</span>
              </div>
            </li>
            <li class="cockpit-cue-stage">
              <span class="cockpit-screen-label">2 · Directional cue</span>
              <div class="cockpit-screen" aria-hidden="true">
                <svg viewBox="0 0 100 100">
                  <path d="M50 16L22 48H40V84H60V48H78Z" fill="#7fda71" />
                </svg>
              </div>
              <div class="cockpit-fixed-cue">
                Cue stays visible for a fixed interval
              </div>
              <Image
                src={keypress}
                alt="Illustration of an index finger pressing the upward key of a four-direction keypad."
                format="webp"
                widths={[240, 480]}
                sizes="240px"
                width={keypress.width}
                height={keypress.height}
                class="cockpit-keypress"
              />
              <span class="cockpit-response-label">
                Response during the cue
              </span>
            </li>
            <li>
              <span class="cockpit-screen-label">3 · Blank interval</span>
              <div class="cockpit-screen" aria-hidden="true"></div>
            </li>
          </ol>
          <figcaption>
            Task illustration. Match the arrow to its key; one of four
            directions is shown. A response does not end the cue.
          </figcaption>
        </figure>
      </div>
    </section>
    <section class="portfolio-section" aria-labelledby="cockpit-motion-heading">
      <h2 id="cockpit-motion-heading">Motion relative to the task</h2>
      <p class="portfolio-copy">
        Unity controlled task and motion commands; under-seat sensors recorded
        the motion used in analysis.
      </p>
      <div class="cockpit-measurement-layout">
        <div class="cockpit-detail">
          <ResearchFigure
            src={sensors}
            alt="Two motion sensors mounted beneath the participant's seat."
          >
            Measured motion beneath the seat.
          </ResearchFigure>
        </div>
        <figure class="portfolio-figure cockpit-geometry">
          <div class="cockpit-geometry-drawing">
            <svg
              viewBox="0 0 440 290"
              role="img"
              aria-labelledby="cockpit-geometry-title cockpit-geometry-description"
            >
              <title id="cockpit-geometry-title">A cue-relative reference frame</title>
              <desc id="cockpit-geometry-description">
                An upward cue defines the along-cue direction. The across-cue
                direction is perpendicular. An illustrative diagonal motion
                vector has components in both directions.
              </desc>
              <path
                d="M115 232V52M115 232H349"
                fill="none"
                stroke="#73858e"
                stroke-width="2"
              />
              <path
                d="M109 61L115 48L121 61M340 226L353 232L340 238"
                fill="none"
                stroke="#73858e"
                stroke-width="2"
              />
              <path
                d="M115 90H269V232"
                fill="none"
                stroke="#b3c4ca"
                stroke-width="2"
                stroke-dasharray="5 6"
              />
              <path
                d="M115 232L265 94"
                fill="none"
                stroke="#346579"
                stroke-width="5"
              />
              <path
                d="M247 97L270 88L260 112"
                fill="none"
                stroke="#346579"
                stroke-width="5"
              />
              <circle cx="115" cy="232" r="5" fill="#346579" />
            </svg>
            <ul
              class="cockpit-direction-key"
              aria-label="Directions in the illustration"
            >
              <li>
                <span aria-hidden="true">↑</span> Along cue
              </li>
              <li>
                <span aria-hidden="true">→</span> Across cue
              </li>
              <li class="cockpit-motion-key">
                <span aria-hidden="true">↗</span> Motion
              </li>
            </ul>
          </div>
          <div
            class="cockpit-window"
            role="img"
            aria-label="Motion was summarized in a fixed window before cue onset. The response occurs after cue onset and does not define the window length."
          >
            <div class="cockpit-window-before">
              <span>Fixed pre-cue window</span>
            </div>
            <div class="cockpit-window-cue">
              <span>Cue</span>
            </div>
            <div class="cockpit-window-after">
              <span>Response</span>
            </div>
          </div>
          <figcaption>
            Method illustration. Motion is expressed along and across the cue
            direction, using a fixed window before the cue.
          </figcaption>
        </figure>
      </div>
      <p class="portfolio-copy">
        Task events linked responses to motion recorded beneath the seat.
      </p>
    </section>
    <details class="portfolio-methods">
      <summary>How motion entered the response-time analysis</summary>
      <p>
        The along-cue component was summarized by its signed mean; the
        across-cue component by its root mean square. The geometry above
        explains the reference frame, rather than showing either computed
        statistic. The pre-cue window did not depend on response time.
      </p>
      <p>
        Unity emitted cue and response markers. Independently recorded motion
        was aligned with these task events for analysis; commanded platform
        settings were not treated as the measured movement.
      </p>
    </details>
  </>
)}
<style>
  .cockpit-setup {
    max-width: 850px;
    margin-inline: auto;
  }
  .cockpit-task-layout,
  .cockpit-measurement-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.65fr);
    gap: 2.25rem;
    align-items: start;
  }
  .cockpit-detail {
    max-width: 340px;
  }
  .cockpit-screens {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .cockpit-screens li {
    min-width: 0;
    position: relative;
  }
  .cockpit-screen-label {
    display: block;
    font-size: 0.85rem;
    line-height: 1.5;
    font-weight: 600;
    min-height: 2.8em;
    margin-bottom: 0.4rem;
    color: var(--portfolio-ink);
  }
  .cockpit-screen {
    aspect-ratio: 4/3;
    background: #191b20;
    border: 5px solid #45515a;
    border-bottom-width: 9px;
    border-radius: 5px;
    display: grid;
    place-items: center;
    position: relative;
  }
  .cockpit-screen::after {
    content: "";
    width: 35%;
    height: 5px;
    position: absolute;
    top: calc(100% + 9px);
    background: #45515a;
  }
  .cockpit-fixation {
    color: #e8ebe9;
    font:
      400 3rem/1 Arial,
      sans-serif;
  }
  .cockpit-screen svg {
    width: 52%;
    height: 75%;
  }
  .cockpit-fixed-cue {
    border-top: 2px solid #74897c;
    margin: 1.15rem 0 0.45rem;
    padding-top: 0.45rem;
    text-align: center;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--portfolio-muted);
  }
  .cockpit-keypress {
    display: block;
    width: 100%;
    max-width: 240px;
    height: auto;
    background: #f5f6f5;
    border-radius: 5px;
    margin: 0.5rem auto 0;
  }
  .cockpit-response-label {
    display: block;
    font-size: 0.8rem;
    line-height: 1.5;
    text-align: center;
    margin-top: 0.4rem;
    color: var(--portfolio-muted);
  }
  .cockpit-task-story figcaption {
    margin-top: 1.25rem;
  }
  .cockpit-measurement-layout {
    align-items: center;
    margin-top: 1.5rem;
  }
  .cockpit-geometry {
    max-width: 580px;
  }
  .cockpit-geometry-drawing {
    background: #f6f8f7;
    border-radius: 5px;
  }
  .cockpit-geometry-drawing svg {
    width: 100%;
    max-width: 440px;
    height: auto;
    margin: 0 auto;
    display: block;
  }
  .cockpit-direction-key {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 1rem;
    list-style: none;
    padding: 0 12px 12px;
    margin: 0;
    color: #355a69;
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .cockpit-direction-key li {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }
  .cockpit-direction-key li span {
    color: #73858e;
    font-size: 1.25em;
    font-weight: 700;
  }
  .cockpit-direction-key .cockpit-motion-key span {
    color: #346579;
  }
  .cockpit-window {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 2px minmax(0, 1fr);
    margin: 1.75rem 0 1rem;
    align-items: stretch;
    color: var(--portfolio-muted);
    font-size: 0.8rem;
    line-height: 1.5;
  }
  .cockpit-window-before {
    min-height: 3.2rem;
    padding: 0.6rem 0.5rem;
    background: var(--portfolio-surface);
    border-bottom: 2px solid var(--portfolio-accent);
    text-align: center;
  }
  .cockpit-window-cue {
    position: relative;
    background: var(--portfolio-accent);
  }
  .cockpit-window-cue span {
    position: absolute;
    white-space: nowrap;
    left: 50%;
    transform: translateX(-50%);
    bottom: 100%;
    font-weight: 650;
  }
  .cockpit-window-after {
    min-height: 3.2rem;
    padding: 0.6rem 0.5rem;
    text-align: center;
    border-bottom: 1px solid var(--portfolio-line);
  }
  .cockpit-window-after span::before {
    content: "•";
    display: inline-block;
    margin-right: 0.5rem;
    color: var(--portfolio-accent);
  }
  .cockpit-window-after span {
    white-space: nowrap;
  }
  @media (max-width: 767px) {
    .cockpit-task-layout,
    .cockpit-measurement-layout {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
    .cockpit-detail {
      width: min(100%, 300px);
      margin-inline: auto;
    }
    .cockpit-geometry {
      width: 100%;
      max-width: 580px;
      margin-inline: auto;
    }
  }
  @media (max-width: 539px) {
    .cockpit-direction-key {
      flex-direction: column;
      align-items: center;
    }
    .cockpit-screens {
      grid-template-columns: 1fr;
      gap: 1.6rem;
    }
    .cockpit-screens li {
      width: 100%;
      max-width: 320px;
      margin-inline: auto;
    }
    .cockpit-screen {
      max-width: 240px;
      margin-inline: auto;
    }
    .cockpit-screen-label {
      min-height: 0;
      text-align: center;
      margin-bottom: 0.7rem;
    }
    .cockpit-fixed-cue {
      max-width: 240px;
      margin-inline: auto;
    }
    .cockpit-keypress {
      width: min(100%, 200px);
    }
    .cockpit-window-before,
    .cockpit-window-after {
      padding-inline: 6px;
    }
    .cockpit-window-after span::before {
      display: block;
      margin-right: 0;
    }
  }
</style>
