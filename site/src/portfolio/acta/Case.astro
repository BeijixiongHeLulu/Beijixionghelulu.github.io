---
import type { ImageMetadata } from "astro";
import type { CasePart } from "../types";
import ResearchFigure from "../../components/ResearchFigure.astro";
import procedure from "./acta-figure-02-english.svg";
import monitoring from "./acta-figure-03-english.svg";
import visibleTimes from "./acta-figure-05-english.svg";
import uncertainTimes from "./acta-figure-06-english.svg";
import monitoringModel from "./acta-figure-07-english.svg";
import incentiveTraits from "./acta-figure-08-english.svg";
import incentives from "./acta-figure-09-english.svg";
import incentiveModel from "./acta-figure-10-english.svg";

interface Props {
  part: CasePart;
}
type Block =
  | { kind: "copy" | "note" | "heading"; text: string }
  | {
      kind: "figure";
      src: ImageMetadata;
      number: string;
      alt: string;
      caption: string;
      compact?: boolean;
    }
  | { kind: "table"; title: string; headings: string[]; rows: string[][] };
interface ResultSection {
  id: string;
  title: string;
  blocks: Block[];
}
const { part } = Astro.props;
const article = "https://doi.org/10.3724/SP.J.1041.2026.0381";
const sourceNote =
  "English labels; significance marks follow the p values reported in the Results.";
const sections: ResultSection[] = [
  {
    id: "acta-monitoring",
    title: "Visible monitoring produced the highest honesty",
    blocks: [
      {
        kind: "copy",
        text: "Honesty was highest under visible monitoring, intermediate when monitoring was uncertain, and lowest without monitoring. The same 46 participants completed Experiment 2 after Experiment 1; uncertain monitoring meant knowing that oversight was possible without seeing its current status.",
      },
      {
        kind: "figure",
        src: monitoring,
        number: "3",
        compact: true,
        alt: "Complete published Figure 3 with English labels. A shows honesty rates for no monitoring, visible monitoring and uncertain monitoring; B shows response times for the same conditions. All three honesty comparisons are significant; uncertain monitoring has shorter response times than either visible monitoring or no monitoring.",
        caption:
          "Honesty and response time across monitoring conditions. Both panels retain the original axes, observations summarized by bars, error bars and comparison brackets.",
      },
      {
        kind: "table",
        title: "All three monitoring comparisons",
        headings: ["Comparison", "Honesty rate", "Response time"],
        rows: [
          [
            "Visible vs no monitoring",
            "98% > 85%; p < .001",
            "0.64 vs 0.63 s; not significant (post-hoc p = 1.00)",
          ],
          [
            "Uncertain vs no monitoring",
            "94% > 85%; p = .001",
            "0.49 < 0.63 s; p < .001",
          ],
          [
            "Visible vs uncertain",
            "98% > 94%; p = .001",
            "0.64 > 0.49 s; p < .001",
          ],
        ],
      },
      {
        kind: "note",
        text: "The Experiment 1 paired test likewise found no response-time difference between visible and absent monitoring (p = .383). In that experiment, behavior type, monitoring and their interaction also had no significant response-time effects (all p > .20).",
      },
    ],
  },
  {
    id: "acta-personality",
    title: "Personality shaped monitoring responses",
    blocks: [
      {
        kind: "copy",
        text: "The honesty benefit of visible monitoring differed between high and low Machiavellianism groups (interaction p = .011) and psychopathy groups (p = .039), but not narcissism groups (p = .148). High and low refer to median splits of SD3 trait scores.",
      },
      {
        kind: "table",
        title:
          "Visible versus absent monitoring within each trait group (Table 2)",
        headings: ["Trait group", "Honesty comparison", "Reported p"],
        rows: [
          ["High Machiavellianism", "98% > 79%", ".005"],
          ["Low Machiavellianism", "99% vs 95%; not significant", ".092"],
          ["High psychopathy", "99% > 82%", "< .001"],
          ["Low psychopathy", "99% vs 94%; not significant", ".091"],
        ],
      },
      { kind: "heading", text: "Narcissism and the time taken to lie" },
      {
        kind: "copy",
        text: "Behavior-by-narcissism interactions appeared in Experiment 1 (p = .030) and under uncertain monitoring in Experiment 2 (p = .038). Their simple comparisons differed: the clearest lying-time cost under uncertain monitoring occurred in the low-narcissism group.",
      },
      {
        kind: "figure",
        src: visibleTimes,
        number: "5",
        alt: "Complete Figure 5 with psychopathy, Machiavellianism and narcissism panels. Each shows honest and dishonest response times in low and high trait groups during Experiment 1. The high-narcissism simple comparison has no significance star because its reported p is .0523.",
        caption:
          "Experiment 1: honest and dishonest response times by trait group. The high-narcissism difference was a trend, not below the .05 threshold.",
      },
      {
        kind: "figure",
        src: uncertainTimes,
        number: "6",
        alt: "Complete Figure 6: response times under uncertain monitoring for low and high psychopathy, Machiavellianism and narcissism groups. The low-narcissism group takes longer to lie than to report honestly; the corresponding high-narcissism difference is not significant.",
        caption:
          "Experiment 2: response times when monitoring status was unknown.",
      },
      {
        kind: "table",
        title: "Every reported narcissism simple comparison",
        headings: [
          "Experiment and group",
          "Lying vs honest response time",
          "Reported p",
        ],
        rows: [
          [
            "Experiment 1 · high narcissism",
            "0.65 vs 0.58 s; not significant",
            ".0523",
          ],
          [
            "Experiment 1 · low narcissism",
            "0.70 vs 0.68 s; not significant",
            ".728",
          ],
          [
            "Uncertain monitoring · high narcissism",
            "0.59 vs 0.48 s; not significant",
            ".232",
          ],
          ["Uncertain monitoring · low narcissism", "1.17 > 0.57 s", ".004"],
        ],
      },
      {
        kind: "copy",
        text: "In the Experiment 2 response-time analysis, lying was slower than honest reporting (0.92 vs 0.53 s, p = .002). Machiavellianism and psychopathy did not significantly moderate this time difference (interaction p = .344 and .842). Their behavior, trait-group and interaction effects were also nonsignificant in Experiment 1 (all p > .05).",
      },
    ],
  },
  {
    id: "acta-incentives",
    title: "Monetary rewards left a partial benefit after withdrawal",
    blocks: [
      {
        kind: "copy",
        text: "Separate groups received monetary incentives (Experiment 3a, n = 60) or moral feedback (3b, n = 62). Monetary rewards increased honesty; some of that gain remained after the reward was removed. Moral feedback showed no significant overall phase effect (p = .319).",
      },
      {
        kind: "note",
        text: "Baseline, intervention and withdrawal occurred within one session. The paper calls withdrawal the “internalization” phase; it tests immediate persistence after feedback removal.",
      },
      {
        kind: "figure",
        src: incentives,
        number: "9",
        compact: true,
        alt: "Complete Figure 9 comparing monetary rewards and moral feedback across baseline, intervention and withdrawal. Monetary honesty rises and then partly declines while remaining above baseline; moral-feedback honesty stays near baseline. The original lines, points and error bars remain, with significance marks based on reported p values.",
        caption:
          "The monetary group retained part of its improvement after withdrawal. Baseline groups did not differ significantly; monetary incentives outperformed moral feedback in the next two phases.",
      },
      {
        kind: "table",
        title: "All monetary-reward phase comparisons",
        headings: ["Comparison", "Honesty rate", "Reported p"],
        rows: [
          ["Intervention vs baseline", "97% > 89%", "< .001"],
          ["Intervention vs withdrawal", "97% > 93%", ".004"],
          ["Withdrawal vs baseline", "93% > 89%", ".013"],
        ],
      },
      {
        kind: "table",
        title: "Monetary incentives versus moral feedback",
        headings: ["Phase", "Honesty rate: monetary vs moral", "Reported p"],
        rows: [
          ["Baseline", "89% vs 88%; not significant", ".646"],
          ["Intervention", "97% > 89%", ".003"],
          ["Withdrawal", "93% > 88%", ".041"],
        ],
      },
      {
        kind: "table",
        title: "Response times shortened in both experiments",
        headings: ["Phase comparison", "Monetary rewards", "Moral feedback"],
        rows: [
          [
            "Baseline vs intervention",
            "5.44 > 5.03 s; p < .001",
            "5.63 > 5.07 s; p < .001",
          ],
          [
            "Intervention vs withdrawal",
            "5.03 > 4.57 s; p < .001",
            "5.07 > 4.45 s; p < .001",
          ],
          [
            "Baseline vs withdrawal",
            "5.44 > 4.57 s; p < .001",
            "5.63 > 4.45 s; p < .001",
          ],
        ],
      },
    ],
  },
  {
    id: "acta-incentive-traits",
    title: "Trait differences persisted beyond the average effect",
    blocks: [
      {
        kind: "copy",
        text: "After monetary rewards were withdrawn, the high-Machiavellianism group was less honest than the low group (92% vs 96%, p = .044). Under moral feedback, high-narcissism participants had lower honesty at baseline, during feedback and after withdrawal.",
      },
      {
        kind: "figure",
        src: incentiveTraits,
        number: "8",
        alt: "Complete Figure 8. Row A shows monetary incentives and row B moral feedback; each row retains baseline, intervention and withdrawal, with high and low groups for all three traits. The significant group differences are Machiavellianism after monetary withdrawal and narcissism at all three moral-feedback phases.",
        caption:
          "All three traits and all phases remain visible. Dark and light bars denote high and low trait groups, respectively.",
      },
      {
        kind: "table",
        title: "High–low trait contrasts across all phases",
        headings: ["Phase", "Monetary rewards", "Moral feedback"],
        rows: [
          [
            "Baseline",
            "No significant high–low contrast for any trait",
            "High narcissism < low; p = .034",
          ],
          [
            "Intervention",
            "No significant high–low contrast for any trait",
            "High narcissism < low; p = .013",
          ],
          [
            "Withdrawal",
            "High Machiavellianism < low; p = .044. Other traits not significant",
            "High narcissism < low; p = .024",
          ],
        ],
      },
      {
        kind: "note",
        text: "Under moral feedback, Machiavellianism and psychopathy high–low comparisons were nonsignificant at every phase (all p > .20 and p > .162, respectively). The monetary-withdrawal result compares groups at that phase; it is not itself a test of which group declined more.",
      },
    ],
  },
  {
    id: "acta-models",
    title: "Trial-level models connected traits with context",
    blocks: [
      {
        kind: "copy",
        text: "Mixed-effects models used continuous standardized trait scores and participant random intercepts. The forest plots show conditional model coefficients; the adjoining curves show model predictions.",
      },
      { kind: "heading", text: "Monitoring presence and visibility" },
      {
        kind: "copy",
        text: "Monitoring and visibility interacted (p < .001). Visibility also interacted with Machiavellianism (p = .013) and narcissism (p = .006), but not psychopathy (p = .445). The visibility-by-narcissism relationship additionally depended on whether monitoring was present (three-way p = .024); the corresponding Machiavellianism and psychopathy three-way terms were nonsignificant (both p > .5).",
      },
      {
        kind: "figure",
        src: monitoringModel,
        number: "7",
        alt: "Complete Figure 7: all fixed-effect odds ratios and confidence intervals for the monitoring model, with every two-way and three-way marginal-prediction panel. Stars for visibility by Machiavellianism and monitoring by visibility by narcissism follow their reported Results p values.",
        caption:
          "Monitoring-model coefficients and predicted honesty probabilities. Predictions do not represent additional observed group means.",
      },
      { kind: "heading", text: "Feedback type, phase and personality" },
      {
        kind: "copy",
        text: "The monetary condition showed larger intervention and withdrawal-related honesty gains than moral feedback (type-by-phase p < .001 for both). Psychopathy was associated with stronger phase-related gains in the monetary reference condition (intervention p = .025; withdrawal p < .001).",
      },
      {
        kind: "copy",
        text: "As Machiavellianism increased, the relative withdrawal-stage change became more favorable to moral feedback (type × withdrawal × trait, p < .001). During intervention, the corresponding relative change favored monetary rewards at higher psychopathy scores (p = .025). These are interactions across conditions and phases, rather than separate within-group tests.",
      },
      {
        kind: "figure",
        src: incentiveModel,
        number: "10",
        alt: "Complete Figure 10: all fixed-effect odds ratios and confidence intervals for feedback type, phase and personality, plus the complete marginal-prediction panels. Original estimates remain; significance annotations follow the p values reported in Results.",
        caption:
          "The combined incentive model. It also displays a withdrawal-by-Machiavellianism term; all coefficients and prediction panels from the published figure are retained.",
      },
    ],
  },
];
---

{part === "intro" && (
  <p>
    I helped design the experiments, programmed the PsychoPy tasks, and analyzed
    trial-level responses with mixed-effects models in Python and R.
  </p>
)}

{part === "visual" && (
  <section
    class="portfolio-section acta-task-section"
    aria-labelledby="acta-task-title"
  >
    <h2 id="acta-task-title">A coin-prediction task across four experiments</h2>
    <ResearchFigure
      src={procedure}
      eager
      class="acta-full-figure"
      alt="Complete published Figure 2, panels a through d, with English labels. A retains the six trial screens and timings. B and C show the coin outcomes and prediction accuracy. D retains monitored and unmonitored branches and the baseline, intervention and withdrawal conditions for monetary rewards and moral feedback."
    >
      <a href={article}>Figure 2, Wang et al., 2026.</a> Participants predicted
      a coin outcome, then reported whether their prediction was correct.
      Reports could be checked against the recorded prediction; reporting a
      correct guess earned more tokens. Panel d shows the monitoring and
      feedback conditions. English labels; original procedure and numerical
      settings retained.
    </ResearchFigure>
    <p class="portfolio-note">
      Programmed monitoring and feedback were framed as AI oversight. In
      Experiment 3a, an unannounced extra reward followed five consecutive
      honest reports; Experiment 3b used encouraging or reflective text.
    </p>
  </section>
)}

{part === "body" && (
  <>
    <nav class="acta-result-nav" aria-label="Results on this page">
      <a href="#acta-monitoring">Monitoring</a>
      <a href="#acta-personality">Personality</a>
      <a href="#acta-incentives">Incentives</a>
      <a href="#acta-incentive-traits">Trait differences</a>
      <a href="#acta-models">Models</a>
      <a href="#acta-statistics">Statistical details</a>
    </nav>
    {sections.map((section) => (
      <section class="portfolio-section" aria-labelledby={section.id}>
        <h2 id={section.id}>{section.title}</h2>
        {section.blocks.map((block) => (
          <>
            {block.kind === "copy" && (
              <p class="portfolio-copy">{block.text}</p>
            )}
            {block.kind === "note" && (
              <p class="portfolio-note">{block.text}</p>
            )}
            {block.kind === "heading" && (
              <h3 class="acta-subheading">{block.text}</h3>
            )}
            {block.kind === "figure" && (
              <ResearchFigure
                src={block.src}
                alt={block.alt}
                class={
                  block.compact ? "acta-compact-figure" : "acta-full-figure"
                }
              >
                <a href={article}>Figure {block.number}.</a> {block.caption}
                <span class="acta-source-note">{sourceNote}</span>
              </ResearchFigure>
            )}
            {block.kind === "table" && (
              <table class="acta-results-table" role="table">
                <caption>{block.title}</caption>
                <thead>
                  <tr role="row">
                    {block.headings.map((heading) => (
                      <th scope="col" role="columnheader">
                        {heading}
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {block.rows.map((row) => (
                    <tr role="row">
                      <th scope="row" role="rowheader">
                        {row[0]}
                      </th>
                      {row.slice(1).map((cell, index) => (
                        <td role="cell" data-label={block.headings[index + 1]}>
                          {cell}
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
          </>
        ))}
      </section>
    ))}

    <details class="portfolio-methods acta-statistics" id="acta-statistics">
      <summary>Reported statistical tests and effect sizes</summary>
      <h3>Monitoring and personality</h3>
      <p>
        Experiment 1 honesty: t(45) = 4.59, p &lt; .001, d = .67. Across the
        three monitoring conditions, honesty F(2, 90) = 18.10, η² = .28, and
        response time F(2, 90) = 34.10, η² = .43 (both p &lt; .001).
      </p>
      <p>
        In the three-condition post-hoc analysis, the honesty contrasts had
        t(45) = −4.60, −3.79 and 3.91, with d = .89, .58 and .54 for visible
        versus absent, uncertain versus absent and visible versus uncertain
        monitoring, respectively. Response-time contrasts had t(45) = 6.48, 6.20
        and −.88, with d = .82, .71 and .06 for visible versus uncertain, absent
        versus uncertain and visible versus absent monitoring.
      </p>
      <ul>
        <li>
          <strong>Machiavellianism:</strong> honesty trait-group F(1, 44) =
          7.81, p = .008, η² = .15; monitoring F = 24.01, p &lt; .001, η² = .35;
          interaction F = 7.11, p = .011, η² = .14.
        </li>
        <li>
          <strong>Narcissism:</strong> honesty trait-group F(1, 44) = 1.10, p =
          .301, η² = .02; monitoring F = 21.69, p &lt; .001, η² = .33;
          interaction F = 2.17, p = .148, η² = .05.
        </li>
        <li>
          <strong>Psychopathy:</strong> honesty trait-group F(1, 44) = 3.82, p =
          .057, η² = .08; monitoring F = 22.78, p &lt; .001, η² = .34;
          interaction F = 4.50, p = .039, η² = .09.
        </li>
      </ul>
      <p>
        The four within-group monitoring contrasts in Table 2 had t = 4.60 (df =
        25), 1.77 (19), 4.44 (28) and 1.80 (16), with d = .90, .40, .82 and .44
        for high/low Machiavellianism and high/low psychopathy, respectively.
      </p>
      <p>
        The behavior-by-narcissism response-time interactions were F(1, 23) =
        5.33, p = .030, η² = .19 in Experiment 1, and F(1, 29) = 4.74, p = .038,
        η² = .14 in Experiment 2. Under uncertain monitoring, the overall
        honest–lying contrast was t(30) = −3.34, p = .002, d = −.60; the
        low-narcissism contrast was t(17) = −3.33, p = .004.
      </p>
      <p>
        In Experiment 2, Machiavellianism group, behavior and interaction tests
        were F(1, 29) = .31, 11.14 and .92 (p = .590, .002 and .344).
        Psychopathy tests were F(1, 29) = .30, 10.81 and .041 (p = .586, .003
        and .842). Behavioral effect sizes were η² = .28 and .27, respectively.
      </p>
      <h3>Incentives and withdrawal</h3>
      <p>
        Monetary incentives: honesty F(2, 118) = 16.06, p &lt; .001, η² = .21;
        response time F(2, 118) = 58.59, p &lt; .001, η² = .49. Moral feedback:
        the reported honesty phase effect was nonsignificant (p = .319);
        response time F(2, 122) = 130.07, p &lt; .001, η² = .68.
      </p>
      <p>
        The combined analysis reported a phase effect, F(2, 240) = 13.30, p &lt;
        .001, η² = .099, a feedback-type effect with p = .057, and a
        phase-by-type interaction with p = .0013. Between-type baseline,
        intervention and withdrawal contrasts were t(120) = .46, 3.07 and 2.06;
        the latter two had d = .55 and .34.
      </p>
      <p>
        The monetary-withdrawal Machiavellianism contrast was t(57.98) = −2.04,
        p = .044, d = −.52. Under moral feedback, high–low narcissism contrasts
        were t(53.62) = −2.16, d = −.51 at baseline; t(49.95) = −2.55, d = −.60
        during intervention; and t(48.52) = −2.31, d = −.54 after withdrawal.
      </p>
      <h3>Conditional model effects</h3>
      <p>
        In the monitoring model, the conditional monitoring main effect was
        nonsignificant (p = .838), visibility was significant (p &lt; .001), and
        Machiavellianism had p = .065. The remaining conditional coefficients
        are shown in Figure 7. These coefficients are interpreted with their
        interaction terms, not as unconditional comparisons of monitoring
        conditions.
      </p>
      <p>
        In the incentive model, intervention and withdrawal coefficients were
        positive (both p &lt; .001), while feedback-type and trait main effects
        were nonsignificant (p = .892 and all p &gt; .1). Figure 10 retains the
        other reported terms and their confidence intervals; exact unreported p
        values are not inferred from their size.
      </p>
    </details>

    <details class="portfolio-methods acta-statistics">
      <summary>Measurement, materials pretest and model checks</summary>
      <p>
        The 27-item Short Dark Triad scale measured Machiavellianism, narcissism
        and psychopathy, with nine items per trait. Reported λ6 coefficients
        were .75, .70 and .72; KMO values were .80, .674 and .78; all Bartlett
        tests had p &lt; .001.
      </p>
      <p>
        An independent pretest with 111 participants checked the moral-feedback
        materials. Encouraging messages had more positive valence than
        reflective messages (7.88 vs 4.86; t(110) = 18.91, p &lt; .001, d =
        1.79). Ratings of encouragement to remain honest (7.47) and prompts to
        reflect (6.45) each exceeded the neutral midpoint of 5: t(110) = 24.02
        and 12.76, d = 2.28 and 1.21 (both p &lt; .001). These were material
        ratings, distinct from the behavioral outcomes.
      </p>
      <p>
        The monitoring model had marginal/conditional R² = .19/.66,
        random-intercept variance = 4.58 and ICC = .58. The incentive model had
        marginal/conditional R² = .116/.517 and ICC = .45. Trait correlations
        were .07/.26/.28 in the monitoring data and .29/.46/.36 in the incentive
        data; reported VIFs were 1.15/1.26/1.09. These are model-fit and
        collinearity summaries, not out-of-sample prediction scores.
      </p>
    </details>

    <section
      class="portfolio-section acta-publication"
      aria-labelledby="acta-publication-title"
    >
      <h2 id="acta-publication-title">Publication</h2>
      <p class="portfolio-copy acta-citation">
        Wang, J., Jiang, X., Chen, Y., Wang, M., &amp; Du, F. (2026). From Overt
        Deterrence to Covert Internalization: Moral Effects of AI Regulation and
        the Moderating Role of Personality Traits.{" "}
        <em>Acta Psychologica Sinica, 58</em>(3), 381–398.
      </p>
    </section>
  </>
)}

<style>
  .acta-task-section {
    margin-top: 0;
  }
  .acta-result-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.4rem;
    padding-block: 1rem;
    margin-bottom: 2.5rem;
    border-block: 1px solid var(--portfolio-line);
    font-size: 0.9rem;
  }
  .acta-result-nav a {
    color: var(--portfolio-accent);
    text-underline-offset: 0.2em;
  }
  h2[id],
  #acta-statistics {
    scroll-margin-top: 6rem;
  }
  .acta-subheading {
    margin-top: 2rem;
  }
  :global(.acta-full-figure) {
    max-width: 68rem;
    margin: 1.5rem auto;
  }
  :global(.acta-compact-figure) {
    max-width: 48rem;
    margin: 1.5rem auto;
  }
  .acta-source-note {
    display: block;
    font-size: 0.875rem;
  }
  .acta-results-table {
    width: 100%;
    max-width: 64rem;
    table-layout: fixed;
    border-collapse: collapse;
    margin: 1.5rem 0 2rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--portfolio-ink);
  }
  .acta-results-table caption {
    text-align: left;
    font-weight: 700;
    font-size: 1rem;
    color: var(--portfolio-ink);
    padding-bottom: 0.8rem;
  }
  .acta-results-table :is(th, td) {
    padding: 0.8rem 0.85rem;
    vertical-align: top;
    text-align: left;
    border-bottom: 1px solid var(--portfolio-line);
    overflow-wrap: anywhere;
  }
  .acta-results-table thead th {
    background: var(--portfolio-surface);
    font-weight: 700;
  }
  .acta-results-table tbody th {
    width: 30%;
    font-weight: 600;
  }
  .acta-results-table td {
    color: var(--portfolio-muted);
  }
  .acta-statistics p {
    max-width: 55rem;
    margin: 1rem 0;
  }
  .acta-statistics h3 {
    margin: 1.8rem 0 0.7rem;
  }
  .acta-statistics ul {
    max-width: 55rem;
    padding-left: 1.3em;
  }
  .acta-statistics li + li {
    margin-top: 0.8rem;
  }
  .acta-publication {
    margin-top: 2.5rem;
    margin-bottom: 0;
  }
  .acta-citation {
    font-size: 0.9375rem;
  }
  @media (max-width: 45rem) {
    .acta-results-table,
