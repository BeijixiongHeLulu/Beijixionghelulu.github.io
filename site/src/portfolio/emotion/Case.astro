---
import ResearchFigure from "../../components/ResearchFigure.astro";
import type { CasePart } from "../types";
import paired from "./emotion-paired-illustration-v2.png";
import coverage from "./emotion-measurement-coverage-v2.png";
import decoding from "./emotion-decoding-result-v2.png";
import photograph from "./emotion-paired-setup.png";

interface Props {
  part: CasePart;
}
const { part } = Astro.props;
---

{part === "intro" && (
  <p>
    I contributed across the behavioral and fNIRS analyses, including
    preprocessing, activation analysis, interbrain synchrony and multivariate
    classification.
  </p>
)}

{part === "visual" && (
  <section
    class="portfolio-section emotion-task-section"
    aria-label="The interpersonal regulation task"
  >
    <ResearchFigure
      src={paired}
      preserveSource={false}
      eager
      class="emotion-pair"
      alt="Published illustration of two participants facing each other across a table, each wearing an fNIRS cap and using a separate display and response keypad."
    >
      Simultaneous fNIRS recording from both participants.{" "}
      <a href="https://doi.org/10.1037/emo0001683">
        Yang et al., 2026, Figure 1A.
      </a>
    </ResearchFigure>
    <figure class="portfolio-figure emotion-story">
      <ol class="emotion-scenes">
        <li>
          <span class="scene-number">1</span>
          <div class="image-and-rating" aria-hidden="true">
            <svg class="emotion-image-card" viewBox="0 0 200 120">
              <rect
                x="1"
                y="1"
                width="198"
                height="118"
                rx="6"
                fill="#e9eff1"
                stroke="#526476"
                stroke-width="2"
              />
              <circle cx="147" cy="32" r="12" fill="#d6c2a4" />
              <path d="M2 113 62 39 108 94 139 65 198 113Z" fill="#90a5ab" />
              <path d="m44 61 18-22 19 23-17-8Z" fill="#f8fafb" />
            </svg>
            <div class="rating-ruler">
              <i />
              <i />
              <i />
              <i />
              <i />
            </div>
          </div>
          <h3>View and rate</h3>
        </li>
        <li class="emotion-interaction">
          <span class="scene-number">2</span>
          <div class="strategy-examples">
            <div>
              <span class="speech-example" aria-hidden="true">
                ↻
              </span>
              <strong>Reappraisal</strong>
            </div>
            <span class="strategy-or">or</span>
            <div>
              <span class="speech-example arithmetic" aria-hidden="true">
                71 − 52 = ?
              </span>
              <strong>Arithmetic distraction</strong>
            </div>
          </div>
          <h3>Regulation interaction</h3>
          <p>Regulator offers a strategy; target responds.</p>
        </li>
        <li>
          <span class="scene-number">3</span>
          <div class="image-and-rating" aria-hidden="true">
            <svg class="emotion-image-card" viewBox="0 0 200 120">
              <rect
                x="1"
                y="1"
                width="198"
                height="118"
                rx="6"
                fill="#e9eff1"
                stroke="#526476"
                stroke-width="2"
              />
              <circle cx="147" cy="32" r="12" fill="#d6c2a4" />
              <path d="M2 113 62 39 108 94 139 65 198 113Z" fill="#90a5ab" />
              <path d="m44 61 18-22 19 23-17-8Z" fill="#f8fafb" />
            </svg>
            <div class="rating-ruler">
              <i />
              <i />
              <i />
              <i />
              <i />
            </div>
          </div>
          <h3>View the same image and rate again</h3>
        </li>
      </ol>
      <figcaption>
        Task illustration: the same negative image was rated before and after
        the interaction. The picture card is illustrative.
      </figcaption>
    </figure>
  </section>
)}

{part === "body" && (
  <>
    <section
      class="portfolio-section"
      aria-labelledby="emotion-measurement-heading"
    >
      <h2 id="emotion-measurement-heading">Where we measured</h2>
      <ResearchFigure
        src={coverage}
        class="emotion-coverage"
        alt="Published fNIRS coverage: frontal and lateral brain views show source and detector positions and the ten sampled regions, including prefrontal, primary motor, primary sensory, Broca and Wernicke regions."
      >
        fNIRS tracks blood-oxygenation changes in sampled cortical regions,
        yielding regional time courses for each person.{" "}
        <a href="https://doi.org/10.1037/emo0001683">Figure 2.</a>
      </ResearchFigure>
    </section>
    <section class="portfolio-section" aria-labelledby="emotion-result-heading">
      <h2 id="emotion-result-heading">
        What the neural patterns distinguished
      </h2>
      <p class="portfolio-copy">
        Interbrain synchronization patterns distinguished strategy and
        rating-defined regulation success in within-participant
        cross-validation. Success meant a more positive rating on the second
        viewing.
      </p>
      <ResearchFigure
        src={decoding}
        class="emotion-result"
        alt="Published decoding results for strategy, regulator success and target success. Each violin retains individual points and the box plot; the dashed horizontal line marks chance accuracy of 0.5. All three comparisons are marked above chance."
      >
        Original published result,{" "}
        <a href="https://doi.org/10.1037/emo0001683">Figure 5A</a>. The three
        targets were strategy, regulator success and target success.
      </ResearchFigure>
    </section>
    <details class="portfolio-methods">
      <summary>Study and analysis details</summary>
      <p>
        After quality checks and preprocessing, activation analyses used
        task-related oxygenated-hemoglobin estimates. Behavioral and activation
        models included a dyad random intercept. For interbrain synchrony,
        trial-level Pearson correlations between ten regions per person formed a
        10 × 10 feature matrix. Support-vector machines were evaluated with
        five-fold within-participant cross-validation.
      </p>
      <ResearchFigure
        src={photograph}
        class="emotion-photo"
        alt="The study's two participants wearing fNIRS caps at the paired setup, with the original published face masks preserved."
      >
        Study photograph from Figure 1B.
      </ResearchFigure>
    </details>
  </>
)}

<style>
  .emotion-task-section {
    margin-top: 0;
  }
  :global(.emotion-pair) {
    max-width: 46rem;
    margin-inline: auto;
  }
  :global(.emotion-coverage) {
    max-width: 48rem;
    margin-inline: auto;
  }
  :global(.emotion-result) {
    max-width: 45rem;
    margin-inline: auto;
  }
  :global(.emotion-photo) {
    max-width: 38rem;
  }
  .emotion-story {
    margin-top: 2.5rem;
  }
  .emotion-scenes {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1.25fr 1fr;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding: 0;
    margin: 0;
  }
  .emotion-scenes li {
    min-width: 0;
    position: relative;
    text-align: center;
  }
  .emotion-scenes li + li::before {
    content: "→";
    position: absolute;
    left: -1.5rem;
    top: 5.5rem;
    color: var(--portfolio-muted);
    font-size: 1.5rem;
  }
  .scene-number {
    display: inline-flex;
    width: 1.7rem;
    height: 1.7rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--portfolio-line);
    border-radius: 50%;
    font-size: 0.8rem;
    color: var(--portfolio-muted);
    margin-bottom: 0.8rem;
  }
  .image-and-rating {
    max-width: 12.5rem;
    min-height: 10rem;
    margin-inline: auto;
  }
  .emotion-image-card {
    width: 100%;
    height: auto;
  }
  .rating-ruler {
    height: 1.6rem;
    display: flex;
    justify-content: space-between;
    margin: 0.7rem 0.8rem 0;
    border-top: 2px solid #637782;
  }
  .rating-ruler i {
    display: block;
    width: 2px;
    height: 0.55rem;
    background: #637782;
  }
  .emotion-scenes h3 {
    margin: 0.6rem 0 0;
    font-size: 1rem;
    line-height: 1.45;
    font-weight: 650;
    color: var(--portfolio-ink);
  }
  .emotion-scenes p {
    margin: 0.5rem 0 0;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--portfolio-muted);
  }
  .strategy-examples {
    min-height: 10rem;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.65rem;
  }
  .strategy-examples > div {
    flex: 1;
    min-width: 0;
  }
  .speech-example {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 4rem;
    padding: 0.5rem;
    border-radius: 1rem 1rem 1rem 0.2rem;
    background: #eef3f4;
    color: #304e5a;
    font-size: 2.3rem;
  }
  .speech-example.arithmetic {
    font-size: clamp(0.8rem, 1.5vw, 1rem);
  }
  .strategy-examples strong {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.83rem;
    line-height: 1.4;
    font-weight: 550;
  }
  .strategy-or {
    font-size: 0.75rem;
    color: var(--portfolio-muted);
  }
  @media (max-width: 700px) {
    .emotion-scenes {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .emotion-scenes li + li::before {
      content: "↓";
      top: -2rem;
      left: calc(50% - 0.4rem);
    }
    .strategy-examples {
      max-width: 24rem;
      margin-inline: auto;
      min-height: 7rem;
    }
    .image-and-rating {
      min-height: auto;
    }
    .speech-example.arithmetic {
      font-size: 1rem;
    }
  }
  @media (max-width: 400px) {
    .strategy-examples {
      flex-direction: column;
      gap: 0.6rem;
    }
    .strategy-examples > div {
      width: 100%;
    }
    .speech-example {
      max-width: 12rem;
      margin-inline: auto;
    }
  }
</style>
