---
import { Image } from "astro:assets";
import dashboard from "./driving-dashboard-illustration.png";
import manual from "./driving-manual-illustration.png";
interface Props {
  state: "memory" | "observe" | "probe" | "resume" | "request" | "manual";
}
const { state } = Astro.props;
---

<div class:list={["driving-scene", `scene-${state}`]} aria-hidden="true">
  {state !== "probe" && (
    <svg class="driving-road" viewBox="0 0 600 400" preserveAspectRatio="none">
      <rect width="600" height="400" fill="#ecf2f3" />
      <path d="M0 160H600V400H0Z" fill="#dfe5da" />
      <path d="M278 150H322L535 400H65Z" fill="#9aa6ad" />
      <path
        d="M282 150L93 400M318 150L507 400"
        stroke="#f7f7f0"
        stroke-width="5"
      />
      <path
        d="M300 153V164M300 177V196M300 218V253"
        stroke="#fff"
        stroke-width="5"
      />
      <path
        d="M344 176L353 198H335Z"
        fill="#b48a5b"
        stroke="#725a3e"
        stroke-width="2"
      />
      <path d="M339 189H350" stroke="#f7f0dd" stroke-width="3" />
    </svg>
  )}
  <Image
    class="driving-dashboard"
    src={state === "manual" ? manual : dashboard}
    alt=""
    width={1536}
    height={1024}
    format="webp"
    widths={[384, 768]}
    sizes="(min-width: 768px) 350px, calc(100vw - 32px)"
    loading="lazy"
  />
  {state === "memory" && (
    <div class="driving-task">
      <span>B</span>
    </div>
  )}
  {state === "probe" && (
    <div class="driving-probe">
      <span>?</span>
      <i></i>
      <i></i>
    </div>
  )}
  {state === "observe" && <div class="driving-signal">Observe road</div>}
  {state === "request" && (
    <div class="driving-signal driving-request">Take control</div>
  )}
</div>
<style>
  .driving-scene {
    position: relative;
    aspect-ratio: 3/2;
    overflow: hidden;
    border-radius: 6px;
    background: #edf2f4;
    isolation: isolate;
  }
  .driving-road {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .driving-dashboard {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    z-index: 1;
  }
  .driving-task {
    position: absolute;
    z-index: 2;
    top: 14%;
    left: 37%;
    width: 26%;
    height: 28%;
    display: grid;
    place-items: center;
    background: #f8fbfd;
    border: 2px solid #496779;
    border-radius: 5px;
    color: #263d4a;
  }
  .driving-task span {
    font:
      600 clamp(1.5rem, 4vw, 2.5rem)/1 Georgia,
      serif;
  }
  .driving-probe {
    position: absolute;
    z-index: 2;
    top: 8%;
    left: 8%;
    right: 8%;
    height: 45%;
    background: #f3f5f7;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border-radius: 10px;
  }
  .driving-probe span {
    font:
      500 2.4rem/1 Georgia,
      serif;
    color: #3b5265;
  }
  .driving-probe i {
    display: block;
    height: 4px;
    width: 40%;
    background: #a7b7c3;
    border-radius: 2px;
  }
  .driving-probe i:last-child {
    width: 28%;
  }
  .driving-signal {
    position: absolute;
    z-index: 2;
    top: 12%;
    left: 19%;
    right: 19%;
    padding: 6px;
    text-align: center;
    background: #f9fbfa;
    border: 1px solid #6d858b;
    color: #294b55;
    font-size: 0.8rem;
    font-weight: 650;
    line-height: 1.3;
    border-radius: 4px;
  }
  .driving-request {
    background: #ffedbf;
    border-color: #b17d24;
    color: #624712;
  }
</style>
