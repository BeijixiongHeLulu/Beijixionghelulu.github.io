---
import ResearchFigure from "../../components/ResearchFigure.astro";
import type { CasePart } from "../types";
import DrivingScene from "./DrivingScene.astro";
import apparatus from "./driving-apparatus.png";
import roadworks from "./driving-roadworks.jpeg";
import pedestrians from "./driving-pedestrian.jpeg";
interface Props {
  part: CasePart;
}
const { part } = Astro.props;
---

{part === "intro" && (
  <p>
    I independently designed the study, implemented its task and warning
    sequences in Unity and C#, and analyzed driving and physiological records.
  </p>
)}
{part === "visual" && (
  <div class="driving-evidence">
    <div class="driving-equipment">
      <ResearchFigure
        src={apparatus}
        alt="A seated participant wears a VR headset and uses a steering wheel and pedals, with recording leads attached."
        eager
      >
        <strong>Research setup.</strong> VR, driving controls and physiological
        recording.
      </ResearchFigure>
    </div>
    <div class="driving-environments">
      <ResearchFigure
        src={roadworks}
        alt="Scenario overview with traffic cones and construction equipment ahead on a simulated road."
      >
        <strong>Roadworks</strong> · Scenario overview
      </ResearchFigure>
      <ResearchFigure
        src={pedestrians}
        alt="Scenario overview with two pedestrian figures ahead on a simulated road."
      >
        <strong>Pedestrians</strong> · Scenario overview
      </ResearchFigure>
    </div>
  </div>
)}
{part === "body" && (
  <>
    <section class="portfolio-section" aria-labelledby="driving-story-heading">
      <h2 id="driving-story-heading">Understanding preparation</h2>
      <p class="portfolio-copy">
        I separated the opportunity to observe the road from the request to take
        control. This let me examine what drivers understood before acting and
        how that preparation related to the braking and steering that followed.
      </p>
      <figure
        class="portfolio-figure driving-story"
        aria-describedby="driving-story-caption"
      >
        <ol
          class="driving-story-stages"
          role="list"
          aria-label="Illustrated trial sequence"
        >
          <li>
            <h3>
              <span class="driving-step">1</span> Automated driving
            </h3>
            <DrivingScene state="memory" />
            <p class="driving-stage-note">Letter task in memory-task groups.</p>
          </li>
          <li>
            <h3>
              <span class="driving-step">2</span> Observe the road
            </h3>
            <DrivingScene state="observe" />
            <p class="driving-stage-note">
              Monitoring request; automation retains control.
            </p>
          </li>
          <li>
            <h3>
              <span class="driving-step">3</span> Road-situation questions
            </h3>
            <DrivingScene state="probe" />
            <p class="driving-stage-note">
              Answer questions about the scene before taking control.
            </p>
          </li>
          <li class="driving-transfer">
            <h3>
              <span class="driving-step">4</span> Transfer to manual control
            </h3>
            <ol
              class="driving-transfer-states"
              aria-label="Three successive control-transfer states"
            >
              <li>
                <DrivingScene state="resume" />
                <strong>Scene resumes</strong>
              </li>
              <li>
                <DrivingScene state="request" />
                <strong>Takeover request</strong>
              </li>
              <li>
                <DrivingScene state="manual" />
                <strong>Manual control</strong>
              </li>
            </ol>
            <p class="driving-stage-note">
              Steering, pedals and speed recorded; workload ratings follow the
              event.
            </p>
          </li>
        </ol>
        <p class="driving-recording">
          <span aria-hidden="true" class="driving-recording-line"></span>Cardiac
          (ECG), muscle (EMG) and electrodermal (EDA) activity recorded
          throughout.
        </p>
        <figcaption id="driving-story-caption">
          Illustration of the study sequence. Participants were assigned to
          one-back, three-back or control groups. The question stage paused the
          simulation; spacing does not represent duration.
        </figcaption>
      </figure>
      <p class="portfolio-copy driving-judgment">
        I considered prior driving tendencies alongside drivers’ understanding
        of the current hazard and physiological changes during preparation.
        Following braking and steering beyond the first input let me examine how
        drivers organized the maneuver and how the developing action sequence
        related to collision risk.
      </p>
    </section>
  </>
)}
<style>
  .driving-evidence {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    align-items: center;
    gap: 2rem;
    max-width: 1088px;
    margin-inline: auto;
  }
  .driving-equipment {
    max-width: 657px;
  }
  .driving-environments {
    display: grid;
    gap: 1.25rem;
    max-width: 420px;
  }
  .driving-story-stages {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem 1.5rem;
    padding: 0;
    margin: 1.5rem 0;
    list-style: none;
  }
  .driving-story-stages > li {
    min-width: 0;
  }
  .driving-story-stages h3 {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 650;
    line-height: 1.45;
    text-wrap: initial;
    margin: 0 0 0.8rem;
  }
  .driving-step {
    color: var(--portfolio-accent);
    font-size: 0.8rem;
    font-weight: 750;
  }
  .driving-stage-note {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--portfolio-muted);
    margin: 0.7rem 0 0;
  }
  .driving-transfer {
    grid-column: 1/-1;
    border-top: 1px solid var(--portfolio-line);
    padding-top: 1.5rem;
  }
  .driving-transfer-states {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .driving-transfer-states li {
    min-width: 0;
    position: relative;
  }
  .driving-transfer-states strong {
    display: block;
    margin-top: 0.65rem;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .driving-transfer-states li + li::before {
    content: "→";
    position: absolute;
    left: -1.25rem;
    top: 35%;
    color: var(--portfolio-muted);
  }
  .driving-recording {
    display: flex;
    gap: 0.8rem;
    align-items: center;
    border-top: 1px solid var(--portfolio-line);
    padding-top: 1rem;
    margin: 1.5rem 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--portfolio-muted);
  }
  .driving-recording-line {
    display: block;
    flex: 0 0 2rem;
    height: 3px;
    background: var(--portfolio-accent);
  }
  .driving-judgment {
    margin-top: 1.25rem;
  }
  @media (max-width: 767px) {
    .driving-evidence {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .driving-equipment {
      margin-inline: auto;
    }
    .driving-environments {
      max-width: 523px;
      margin-inline: auto;
      gap: 1.5rem;
    }
    .driving-story-stages {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
    .driving-transfer-states {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
    .driving-transfer-states li + li::before {
      content: "↓";
      top: -1.6rem;
      left: 50%;
    }
    .driving-recording-line {
      display: none;
    }
  }
</style>
