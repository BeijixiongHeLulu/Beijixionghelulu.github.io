---
import { VISITOR_API } from "../lib/visitor-config";
import "../styles/visitors.css";
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<section
  class:list={["visitor-section", { "visitor-compact": compact }]}
  data-visitor-dashboard
  data-api={VISITOR_API}
  data-compact={String(compact)}
  aria-labelledby="visitor-heading"
>
  <div class="visitor-heading-row">
    <div>
      <p class="visitor-eyebrow">Across the globe</p>
      <h2 id="visitor-heading" class="visitor-heading">
        A world of visitors
      </h2>
      <p class="visitor-description">
        Visits to this website, mapped by region.
      </p>
    </div>
    {compact ? (
      <a class="action-link" href="/visitors/">
        Explore visits <span aria-hidden="true">↗</span>
      </a>
    ) : (
      <div class="visitor-tools">
        <label>
          <span class="sr-only">Time period</span>
          <select data-visitor-period aria-label="Time period">
            <option value="1">Last 24 hours</option>
            <option value="7">Last 7 days</option>
            <option value="30" selected>
              Last 30 days
            </option>
            <option value="90">Last 90 days</option>
            <option value="all">All time</option>
          </select>
        </label>
        <button type="button" data-visitor-refresh class="visitor-button">
          Refresh
        </button>
      </div>
    )}
  </div>

  <div class="visitor-overview">
    <div class="visitor-globe-panel">
      <div class="visitor-globe-topline">
        <span>
          <i aria-hidden="true"></i> Visitor atlas
        </span>
        <span data-visitor-range>Last 30 days</span>
      </div>
      <div class="visitor-globe-wrap">
        <canvas
          data-visitor-globe
          width="760"
          height="760"
          tabindex="0"
          role="img"
          aria-label="Interactive 3D globe of visitor regions. Drag or use arrow keys to rotate. Regional totals are also listed below."
        ></canvas>
        <p class="visitor-globe-fallback" data-globe-fallback hidden>
          3D view unavailable on this device. Visitor regions are listed
          alongside the map.
        </p>
      </div>
      <div class="visitor-globe-bottomline">
        <span>Drag to explore · arrow keys to rotate</span>
        <button type="button" data-globe-rotate aria-pressed="true">
          Pause rotation
        </button>
      </div>
    </div>
    <div class="visitor-side">
      <div class="visitor-metrics" aria-label="Visitor totals">
        <div>
          <span data-visitor-views>—</span>
          <p>Page views</p>
        </div>
        <div>
          <span data-visitor-ips>—</span>
          <p>Unique IPs</p>
        </div>
        <div>
          <span data-visitor-countries>—</span>
          <p>Countries & regions</p>
        </div>
      </div>
      <div class="visitor-country-block">
        <h3>Where visits come from</h3>
        <ul class="visitor-countries" data-visitor-country-list>
          <li class="visitor-empty">Loading visitor regions…</li>
        </ul>
      </div>
      <p class="visitor-state" data-visitor-status role="status">
        Connecting to visitor statistics…
      </p>
      <button
        class="visitor-button visitor-retry"
        data-visitor-retry
        type="button"
        hidden
      >
        Try again
      </button>
    </div>
  </div>

  {!compact && (
    <>
      <div class="visitor-trend-section">
        <div class="visitor-section-title">
          <h3>Visits over time</h3>
          <span>Daily page views · UTC</span>
        </div>
        <div
          class="visitor-trend"
          data-visitor-trend
          role="img"
          aria-label="Daily page views. Loading statistics."
        ></div>
        <div class="visitor-trend-labels">
          <span data-trend-start>—</span>
          <span data-trend-end>—</span>
        </div>
      </div>
      <div class="visitor-private-callout" data-owner-callout>
        <div>
          <h3>Your private visit log</h3>
          <p>View IP addresses, visit times, counts, pages and referrers.</p>
        </div>
        <a
          class="visitor-button visitor-primary"
          href={`${VISITOR_API}/admin/`}
          data-astro-reload
        >
          Owner sign-in <span aria-hidden="true">↗</span>
        </a>
      </div>
      <section
        class="visitor-private-records"
        data-owner-records
        hidden
        aria-labelledby="visit-log-heading"
      >
        <div class="visitor-section-title">
          <h3 id="visit-log-heading">Private visit log</h3>
          <a
            href={`${VISITOR_API}/signout-with-chatgpt?return_to=%2F`}
            data-astro-reload
          >
            Sign out
          </a>
        </div>
        <div class="visitor-record-tools">
          <div class="visitor-tabs" role="group" aria-label="Record type">
            <button type="button" data-record-mode="ips" aria-pressed="true">
              IP summary
            </button>
            <button
              type="button"
              data-record-mode="events"
              aria-pressed="false"
            >
              Visit log
            </button>
          </div>
          <input
            type="search"
            data-record-search
            placeholder="Search IP, region or page"
            aria-label="Search visit records"
          />
          <select data-record-zone aria-label="Time zone">
            <option value="Asia/Shanghai">Beijing time (UTC+8)</option>
            <option value="local">Your local time</option>
            <option value="UTC">UTC</option>
          </select>
        </div>
        <p data-record-status class="visitor-state" role="status">
          Loading private records…
        </p>
        <div
          class="visitor-table-scroll"
          tabindex="0"
          role="region"
          aria-label="Visit records, horizontally scrollable"
        >
          <table class="visitor-table">
            <thead data-record-head></thead>
            <tbody data-record-body></tbody>
          </table>
        </div>
        <div class="visitor-pagination">
          <button
            type="button"
            class="visitor-button"
            data-record-prev
            disabled
          >
            Previous
          </button>
          <span data-record-page>Page 1</span>
          <button
            type="button"
            class="visitor-button"
            data-record-next
            disabled
          >
            Next
          </button>
        </div>
      </section>
    </>
  )}
  <p class="visitor-footnote">
    IP-based locations are approximate. An IP may represent a shared network or
    VPN. Only the owner can access individual records. Statistics begin when
    tracking is enabled.
  </p>
</section>

<script>
  import { setupVisitorDashboard } from "../scripts/visitor-dashboard";
  document.addEventListener("astro:page-load", setupVisitorDashboard);
</script>
