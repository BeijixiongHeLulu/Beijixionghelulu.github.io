---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  eager?: boolean;
  class?: string;
  preserveSource?: boolean;
}

const {
  src,
  alt,
  eager = false,
  class: className,
  preserveSource = true,
} = Astro.props;
const widths = [320, 640, 960, 1280].filter((width) => width <= src.width);
---

<figure class:list={["portfolio-figure research-figure", className]}>
  <a
    class="research-figure-image"
    href={src.src}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`Open full-size image: ${alt}`}
  >
    {preserveSource || src.format === "svg" ? (
      <img
        src={src.src}
        alt={alt}
        width={src.width}
        height={src.height}
        loading={eager ? "eager" : "lazy"}
        fetchpriority={eager ? "high" : undefined}
        decoding="async"
      />
    ) : (
      <Image
        src={src}
        alt={alt}
        format="webp"
        quality={90}
        widths={widths.length ? widths : [src.width]}
        sizes="(min-width: 1152px) 1088px, calc(100vw - 32px)"
        loading={eager ? "eager" : "lazy"}
        fetchpriority={eager ? "high" : undefined}
        decoding="async"
      />
    )}
    <span class="research-figure-enlarge" aria-hidden="true">
      Full size ↗
    </span>
    <span class="sr-only">Opens in a new tab.</span>
  </a>
  {Astro.slots.has("default") && (
    <figcaption>
      <slot />
    </figcaption>
  )}
</figure>
