{
  "name": "jianshu-wang-academic-site",
  "private": true,
  "type": "module",
  "version": "0.9.0",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "Jianshu Wang ? academic profile, publications, research and CV.",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/stage-static.mjs && astro build --force && node scripts/finish-build.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run tests",
    "test:content": "node scripts/verify-migration.mjs",
    "test:browser": "playwright test",
    "verify": "pnpm test && pnpm astro check && pnpm build && pnpm test:content",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "author": "Jiaxin Peng",
  "license": "MIT",
  "keywords": [
    "astro",
    "theme",
    "portfolio",
    "academic",
    "unocss"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Beijixionghelulu/Beijixionghelulu.github.io.git"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/mdx": "8.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/crimson-pro": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "astro": "7.3.1",
    "astro-seo": "^1.2.0",
    "sharp": "0.35.4",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@iconify-json/academicons": "^1.2.4",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ph": "^1.2.2",
    "@playwright/test": "1.63.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "unocss": "^66.10.0",
    "vitest": "^5.0.0"
  }
}
